# Porta da API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Origem dos dados: "memory" (mock, padrão — não precisa de banco) ou "prisma" (PostgreSQL real)
DATA_SOURCE=memory

# PostgreSQL (usado quando DATA_SOURCE=prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/case_tracker?schema=public"

# Autenticação: "mock" (padrão, sem Azure AD) ou "entra" (Microsoft Entra ID)
AUTH_MODE=mock

# Microsoft Entra ID (necessário quando AUTH_MODE=entra)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Pasta local para anexos enviados (modo demo)
UPLOADS_DIR=uploads
